# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (pilih salah satu)
# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/calmsey-baas?schema=public"

# MySQL (uncomment jika pakai MySQL)
# DATABASE_URL="mysql://user:password@localhost:3306/calmsey-baas"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Storage Configuration (local/s3)
STORAGE_TYPE=local
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=your-bucket

# Email Configuration
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
EMAIL_FROM=noreply@yourdomain.com

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=24h  # Options: 1h, 24h, 7d, 30d, etc.

# Rate Limiting Configuration
RATE_LIMIT_MAX=100                    # Default max requests
RATE_LIMIT_TIME_WINDOW=1 minute       # Default time window

# Auth endpoints (more strict)
AUTH_RATE_LIMIT_MAX=10                # Max requests for login/register
AUTH_RATE_LIMIT_WINDOW=15 minutes     # Time window for auth

# User endpoints
USER_RATE_LIMIT_MAX=100               # Max requests per user
USER_RATE_LIMIT_WINDOW=1 minute       # Time window

# Dynamic API endpoints (per API key)
API_RATE_LIMIT_MAX=1000               # Max requests per API key (read)
API_RATE_LIMIT_WINDOW=1 hour          # Time window
API_WRITE_RATE_LIMIT_MAX=100          # Max requests for write operations

# Collection management
COLLECTION_RATE_LIMIT_MAX=50          # Max requests for collection operations
COLLECTION_RATE_LIMIT_WINDOW=1 minute  # Time window

# AWS S3 Configuration (optional - can also be set per project)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_BUCKET_NAME=your-bucket-name

# For S3-compatible services (MinIO, DigitalOcean Spaces, etc.)
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

DEEPSEEK_API_KEY=your-secret-access-key
# optional
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat