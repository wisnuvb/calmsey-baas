// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // bisa diganti ke "mysql"
  url      = env("DATABASE_URL")
}

// Core system tables

// User management untuk admin BaaS
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  projects  Project[]
  apiKeys   ApiKey[]
}

enum UserRole {
  ADMIN
  USER
}

// Project/Tenant - setiap project punya database schema sendiri
model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  database    String?  // database name atau schema name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  collections Collection[]
  apiKeys     ApiKey[]
  settings    ProjectSettings?
}

// Collection = Table definition (dynamic schema)
model Collection {
  id          String   @id @default(cuid())
  name        String   // e.g., "products", "posts", "users"
  slug        String   // URL-friendly name
  schema      Json     // JSON schema definition
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, slug])
}

// API Keys untuk authentication
model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  createdAt DateTime @default(now())
  lastUsed  DateTime?
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Project settings (email, storage, etc.)
model ProjectSettings {
  id              String   @id @default(cuid())
  
  // Email settings
  emailEnabled    Boolean  @default(false)
  emailProvider   String?
  emailConfig     Json?
  
  // Storage settings
  storageType     String   @default("local")
  storageConfig   Json?
  
  // Auth settings
  authEnabled     Boolean  @default(true)
  jwtExpiry       Int      @default(86400) // seconds
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
